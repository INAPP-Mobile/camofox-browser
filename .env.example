# Camofox Browser - Railway Template Environment Variables

# Port the server listens on (Railway injects this)
PORT=9377

# API key for authentication (leave empty to disable)
CAMOFOX_API_KEY=

# Admin key for privileged operations
CAMOFOX_ADMIN_KEY=

# Browser profiles directory (set to /data/profiles if using a Railway volume)
CAMOFOX_PROFILE_DIR=

# Cookies directory
CAMOFOX_COOKIES_DIR=

# Interactive mode (off/desktop/novnc/auto)
CAMOFOX_INTERACTIVE=off

# Maximum concurrent sessions
MAX_SESSIONS=50

# Browser idle timeout in ms
BROWSER_IDLE_TIMEOUT_MS=300000

# Enable YouTube plugin
CAMOFOX_YOUTUBE_ENABLED=true
